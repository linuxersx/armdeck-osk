_enable_services() {
  command -v systemctl >/dev/null 2>&1 || return 0
  for runtime in /run/user/[0-9]*; do
    [ -d "$runtime" ] || continue
    [ -S "$runtime/bus" ] || continue
    uid=${runtime##*/}
    user=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)
    [ -n "$user" ] || continue
    runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" \
      systemctl --user daemon-reload >/dev/null 2>&1 || true
    runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" \
      systemctl --user enable armdeck-oskd.service armdeck-osk-input.service \
      >/dev/null 2>&1 || true
  done
}

_restart_services() {
  command -v systemctl >/dev/null 2>&1 || return 0
  for runtime in /run/user/[0-9]*; do
    [ -d "$runtime" ] || continue
    [ -S "$runtime/bus" ] || continue
    uid=${runtime##*/}
    user=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)
    [ -n "$user" ] || continue
    runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" \
      systemctl --user restart armdeck-oskd.service armdeck-osk-input.service \
      >/dev/null 2>&1 || true
  done
}

post_install() {
  udevadm control --reload-rules >/dev/null 2>&1 || true
  udevadm trigger --subsystem-match=input >/dev/null 2>&1 || true
  _enable_services
  _restart_services
  cat <<'MSG'
ArmDeck on-screen keyboard installed.
Services enabled and started for the active session:
  armdeck-oskd.service
  armdeck-osk-input.service
MSG
}

post_upgrade() {
  udevadm control --reload-rules >/dev/null 2>&1 || true
  udevadm trigger --subsystem-match=input >/dev/null 2>&1 || true
  _enable_services
  _restart_services
}
